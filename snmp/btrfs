#!/usr/bin/env python3
import argparse
import base64
import gzip
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile


VERSION = 1

_SIZE_UNITS = {
    "B": 1,
    "KiB": 1024,
    "MiB": 1024**2,
    "GiB": 1024**3,
    "TiB": 1024**4,
    "PiB": 1024**5,
    "EiB": 1024**6,
}


def proc_err(argv, proc):
    cmd = " ".join(argv) if isinstance(argv, (list, tuple)) else str(argv)
    stderr = (proc.stderr or "").strip()
    first = stderr.splitlines()[0] if stderr else ""
    return f"{subprocess.CalledProcessError(proc.returncode, cmd, stderr)}{(' (' + first + ')') if first else ''}"


def print_data(data, error, error_msg):
    return json.dumps(
        {
            "data": data,
            "error": error,
            "errorString": error_msg,
            "version": VERSION,
        }
    )


def _gzip_base64(text):
    raw = text.encode("utf-8")
    return base64.b64encode(gzip.compress(raw)).decode("ascii")


def emit_data(data, error, error_msg, output_path=None, compress=False):
    payload = print_data(data, error, error_msg)
    if compress:
        payload = _gzip_base64(payload)
    if not output_path or output_path == "-":
        print(payload)
        return True

    out_dir = os.path.dirname(output_path)
    temp_path = None
    try:
        if out_dir:
            os.makedirs(out_dir, exist_ok=True)
        fd, temp_path = tempfile.mkstemp(prefix=".btrfs.", dir=(out_dir or None))
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(payload)
            f.write("\n")
        os.replace(temp_path, output_path)
        return True
    except OSError as e:
        if temp_path and os.path.exists(temp_path):
            try:
                os.unlink(temp_path)
            except OSError:
                pass
        print(print_data({}, 1, f"Failed to write output {output_path}: {e}"))
        return False


def _default_config_path():
    # Use the documented extension layout.
    script = os.path.realpath(sys.argv[0])
    return f"/etc/snmp/extension/{os.path.basename(script)}.conf"


def _read_config(path):
    # One entry per line, comments start with '#'.
    # Supported formats:
    #   /mountpoint
    #   label /mountpoint
    #   compress true|false
    mounts = []
    compress = True
    with open(path, "r", encoding="utf-8") as f:
        for ln in f:
            ln = ln.strip()
            if not ln or ln.startswith("#"):
                continue
            m = re.match(r"^(compress|gzip)\s+(\S+)\s*$", ln, re.IGNORECASE)
            if m:
                val = m.group(2).strip().lower()
                if val in {"1", "true", "yes", "on"}:
                    compress = True
                elif val in {"0", "false", "no", "off"}:
                    compress = False
                continue
            parts = ln.split(None, 1)
            if len(parts) == 1:
                mounts.append({"id": parts[0], "mountpoint": parts[0]})
            else:
                mounts.append({"id": parts[0], "mountpoint": parts[1].strip()})
    return {"mounts": mounts, "compress": compress}


def _unescape_fstab_field(field):
    def repl(m):
        return chr(int(m.group(1), 8))

    return re.sub(r"\\([0-7]{3})", repl, field)


def _read_btrfs_mounts_from_fstab(path="/etc/fstab"):
    mounts = []
    seen = set()
    with open(path, "r", encoding="utf-8") as f:
        for ln in f:
            ln = ln.strip()
            if not ln or ln.startswith("#"):
                continue
            if "#" in ln:
                ln = ln.split("#", 1)[0].rstrip()
            if not ln:
                continue
            parts = ln.split()
            if len(parts) < 3:
                continue
            fs_vfstype = parts[2].strip().lower()
            if fs_vfstype != "btrfs":
                continue
            mountpoint = _unescape_fstab_field(parts[1].strip())
            if mountpoint and mountpoint not in seen:
                seen.add(mountpoint)
                mounts.append(mountpoint)
    return mounts


def _write_autogen_config(config_path, mountpoints):
    out_dir = os.path.dirname(config_path)
    temp_path = None
    if out_dir:
        os.makedirs(out_dir, exist_ok=True)
    fd, temp_path = tempfile.mkstemp(prefix=".btrfs.config.", dir=(out_dir or None))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write("# Auto-generated from /etc/fstab (btrfs entries)\n")
            f.write("compress true\n")
            for mp in mountpoints:
                f.write(mp)
                f.write("\n")
        os.replace(temp_path, config_path)
    except OSError:
        if temp_path and os.path.exists(temp_path):
            try:
                os.unlink(temp_path)
            except OSError:
                pass
        raise


def _run(argv):
    proc = subprocess.run(argv, capture_output=True, text=True)
    return proc.returncode, (proc.stdout or ""), (proc.stderr or ""), proc


def _parse_human_size_to_bytes(s):
    # Examples: 25.44TiB, 512.00MiB, 0.00B, 123456
    s = s.strip()
    if re.match(r"^[0-9]+$", s):
        return int(s)
    m = re.match(r"^([0-9]+(?:\.[0-9]+)?)\s*([A-Za-z]+)$", s)
    if not m:
        return None
    val = float(m.group(1))
    unit = m.group(2)
    mul = _SIZE_UNITS.get(unit)
    if mul is None:
        return None
    return int(val * mul)


def _parse_btrfs_version(text):
    lines = [ln.rstrip("\n") for ln in (text or "").splitlines() if ln.strip()]
    out = {"raw": (text or "").strip()}
    if not lines:
        return out
    m = re.search(r"btrfs-progs\s+v(\S+)", lines[0])
    if m:
        out["version"] = m.group(1)
    # Feature flags are free-form; keep tokens.
    if len(lines) > 1:
        out["features"] = lines[1].split()
    return out


def _parse_filesystem_show(text):
    data = {"devices": []}
    for ln in (text or "").splitlines():
        ln = ln.strip()
        m = re.search(r"Label:\s+'([^']*)'\s+uuid:\s+([0-9a-fA-F-]+)", ln)
        if m:
            data["label"] = m.group(1)
            data["uuid"] = m.group(2)
            continue
        m = re.search(r"Total devices\s+(\d+)\s+FS bytes used\s+(\S+)", ln)
        if m:
            data["total_devices"] = int(m.group(1))
            raw = m.group(2)
            data["fs_bytes_used"] = {"raw": raw, "bytes": _parse_human_size_to_bytes(raw)}
            continue
        m = re.match(r"^devid\s+(\d+)\s+size\s+(\S+)\s+used\s+(\S+)\s+path\s+(\S+)", ln)
        if m:
            devid = int(m.group(1))
            size_raw = m.group(2)
            used_raw = m.group(3)
            path = m.group(4)
            data["devices"].append(
                {
                    "devid": devid,
                    "path": path,
                    "size": {"raw": size_raw, "bytes": _parse_human_size_to_bytes(size_raw)},
                    "used": {"raw": used_raw, "bytes": _parse_human_size_to_bytes(used_raw)},
                }
            )
    return data


def _parse_filesystem_df(text):
    # Example line: Data, RAID6: total=25.90TiB, used=25.41TiB
    out = {"classes": []}
    for ln in (text or "").splitlines():
        ln = ln.strip()
        if not ln or ln.startswith("#"):
            continue
        m = re.match(r"^([^,]+),\s*([^:]+):\s*(.*)$", ln)
        if not m:
            continue
        clazz = m.group(1).strip()
        profile = m.group(2).strip()
        rest = m.group(3).strip()
        values = {}
        for item in rest.split(","):
            if "=" not in item:
                continue
            k, v = item.strip().split("=", 1)
            v = v.strip()
            values[k] = {"raw": v, "bytes": _parse_human_size_to_bytes(v)}
        out["classes"].append({"class": clazz, "profile": profile, **values})
    return out


def _parse_device_stats(text):
    # Format (common): [/dev/sdc].write_io_errs    0
    out = {}
    for ln in (text or "").splitlines():
        ln = ln.strip()
        if not ln or ln.startswith("#"):
            continue
        m = re.match(r"^\[([^\]]+)\]\.([A-Za-z0-9_]+)\s+(\d+)\s*$", ln)
        if not m:
            continue
        dev = m.group(1)
        key = m.group(2)
        val = int(m.group(3))
        out.setdefault(dev, {})[key] = val
    return {"devices": out}


def _parse_filesystem_usage_bytes(text):
    lines = [ln.rstrip("\n") for ln in (text or "").splitlines()]

    overall = {}
    profiles = []
    unallocated = {"devices": {}}

    i = 0
    # Overall
    while i < len(lines):
        if lines[i].strip().startswith("Overall:"):
            i += 1
            break
        i += 1

    while i < len(lines):
        ln = lines[i]
        if not ln.strip():
            i += 1
            break
        m = re.match(r"^\s*([^:]+):\s*(.*)$", ln)
        if m:
            key = m.group(1).strip().lower()
            val = m.group(2).strip()
            if key.startswith("free (estimated)"):
                # "<bytes>\t(min: <bytes>)"
                compact = re.sub(r"\s+", " ", val.replace("\t", " ")).strip()
                m2 = re.match(r"^(\d+)\s*\(min:\s*(\d+)\)\s*$", compact)
                if m2:
                    overall["free_estimated_bytes"] = int(m2.group(1))
                    overall["free_estimated_min_bytes"] = int(m2.group(2))
                else:
                    overall["free_estimated_raw"] = val
            elif key.startswith("global reserve"):
                compact = re.sub(r"\s+", " ", val.replace("\t", " ")).strip()
                m2 = re.match(r"^(\d+)\s*\(used:\s*(\d+)\)\s*$", compact)
                if m2:
                    overall["global_reserve_bytes"] = int(m2.group(1))
                    overall["global_reserve_used_bytes"] = int(m2.group(2))
                else:
                    overall["global_reserve_raw"] = val
            elif key in {
                "device size",
                "device allocated",
                "device unallocated",
                "device missing",
                "device slack",
                "used",
                "free (statfs, df)",
            }:
                m2 = re.match(r"^(\d+)$", val)
                if key == "free (statfs, df)":
                    overall["free_statfs_df_bytes"] = int(m2.group(1)) if m2 else val
                else:
                    overall[key.replace(" ", "_") + "_bytes"] = int(m2.group(1)) if m2 else val
            elif key in {"data ratio", "metadata ratio"}:
                try:
                    overall[key.replace(" ", "_")] = float(val)
                except ValueError:
                    overall[key.replace(" ", "_")] = val
            elif key.startswith("multiple profiles"):
                overall["multiple_profiles"] = (val.lower() == "yes")
            else:
                overall[key.replace(" ", "_")] = val
        i += 1

    # Profiles + unallocated
    profile_re = re.compile(
        r"^([A-Za-z]+),([^:]+):\s+Size:(\d+),\s+Used:(\d+)(?:\s+\(([0-9.]+)%\))?\s*$"
    )
    while i < len(lines):
        ln = lines[i].strip()
        if not ln:
            i += 1
            continue
        if ln.startswith("Unallocated:"):
            i += 1
            while i < len(lines) and lines[i].strip() and not lines[i].lstrip().startswith("#"):
                m = re.match(r"^\s*(\S+)\s+(\d+)\s*$", lines[i])
                if m:
                    unallocated["devices"][m.group(1)] = int(m.group(2))
                i += 1
            continue

        m = profile_re.match(ln)
        if m:
            clazz = m.group(1)
            profile = m.group(2)
            size_b = int(m.group(3))
            used_b = int(m.group(4))
            used_pct = float(m.group(5)) if m.group(5) is not None else None
            p = {
                "class": clazz,
                "profile": profile,
                "size_bytes": size_b,
                "used_bytes": used_b,
                "used_pct": used_pct,
                "devices": {},
            }
            i += 1
            while i < len(lines) and lines[i].strip() and not lines[i].lstrip().startswith("#"):
                m2 = re.match(r"^\s*(\S+)\s+(\d+)\s*$", lines[i])
                if m2:
                    p["devices"][m2.group(1)] = int(m2.group(2))
                    i += 1
                    continue
                break
            profiles.append(p)
            continue
        i += 1

    return {"overall": overall, "profiles": profiles, "unallocated": unallocated}


def _parse_filesystem_usage_T(text):
    lines = [ln.rstrip("\n") for ln in (text or "").splitlines()]
    overall = {}
    devices = []
    totals = None
    used = None

    i = 0
    # Overall
    while i < len(lines):
        if lines[i].strip().startswith("Overall:"):
            i += 1
            break
        i += 1

    while i < len(lines):
        ln = lines[i]
        if not ln.strip():
            i += 1
            break
        m = re.match(r"^\s*([^:]+):\s*(.*)$", ln)
        if m:
            key = m.group(1).strip().lower().replace(" ", "_")
            val = m.group(2).strip()
            if key.startswith("free_(estimated)"):
                compact = re.sub(r"\s+", " ", val.replace("\t", " ")).strip()
                m2 = re.match(r"^(\S+)\s*\(min:\s*(\S+)\)\s*$", compact)
                if m2:
                    v = m2.group(1)
                    vmin = m2.group(2)
                    overall["free_estimated"] = {"raw": v, "bytes": _parse_human_size_to_bytes(v)}
                    overall["free_estimated_min"] = {
                        "raw": vmin,
                        "bytes": _parse_human_size_to_bytes(vmin),
                    }
                else:
                    overall["free_estimated_raw"] = val
            elif key.startswith("global_reserve"):
                compact = re.sub(r"\s+", " ", val.replace("\t", " ")).strip()
                m2 = re.match(r"^(\S+)\s*\(used:\s*(\S+)\)\s*$", compact)
                if m2:
                    v = m2.group(1)
                    vused = m2.group(2)
                    overall["global_reserve"] = {"raw": v, "bytes": _parse_human_size_to_bytes(v)}
                    overall["global_reserve_used"] = {
                        "raw": vused,
                        "bytes": _parse_human_size_to_bytes(vused),
                    }
                else:
                    overall["global_reserve_raw"] = val
            elif key in {
                "device_size",
                "device_allocated",
                "device_unallocated",
                "device_missing",
                "device_slack",
                "used",
                "free_(statfs,_df)",
            }:
                overall[key.replace("(statfs,_df)", "statfs_df")] = {
                    "raw": val,
                    "bytes": _parse_human_size_to_bytes(val),
                }
            elif key in {"data_ratio", "metadata_ratio"}:
                try:
                    overall[key] = float(val)
                except ValueError:
                    overall[key] = val
            elif key == "multiple_profiles":
                overall[key] = (val.lower() == "yes")
            else:
                overall[key] = val
        i += 1

    # Device table
    header1 = None
    header2 = None
    while i < len(lines):
        if re.match(r"^\s*Id\s+Path\s+", lines[i]):
            header2 = re.split(r"\s+", lines[i].strip())
            if i > 0:
                header1 = re.split(r"\s+", lines[i - 1].strip())
            i += 1
            break
        i += 1

    if header2 and "Unallocated" in header2:
        idx_unalloc = header2.index("Unallocated")
        type_profiles = header2[2:idx_unalloc]
        types = header1 if header1 else [f"col{i}" for i in range(len(type_profiles))]
        if len(types) != len(type_profiles):
            types = types[: len(type_profiles)]
            while len(types) < len(type_profiles):
                types.append(f"col{len(types)}")

        while i < len(lines):
            ln = lines[i].strip()
            if not ln or ln.startswith("#"):
                i += 1
                continue
            if ln.startswith("--"):
                i += 1
                continue
            parts = re.split(r"\s+", ln)
            if len(parts) < 2:
                i += 1
                continue

            if parts[0].isdigit():
                row = {"id": int(parts[0]), "path": parts[1], "usage": {}}
                pos = 2
                for t, prof in zip(types, type_profiles):
                    raw = parts[pos] if pos < len(parts) else "-"
                    row["usage"][t] = {"profile": prof, "raw": raw, "bytes": _parse_human_size_to_bytes(raw) if raw != "-" else None}
                    pos += 1
                for k in ("Unallocated", "Total", "Slack"):
                    raw = parts[pos] if pos < len(parts) else "-"
                    row[k.lower()] = {"raw": raw, "bytes": _parse_human_size_to_bytes(raw) if raw != "-" else None}
                    pos += 1
                devices.append(row)
            elif parts[0] == "Total":
                totals = {"raw": ln}
            elif parts[0] == "Used":
                used = {"raw": ln}
            i += 1

    out = {"overall": overall, "devices": devices}
    if totals is not None:
        out["total_row"] = totals
    if used is not None:
        out["used_row"] = used
    return out


def main(args):
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument(
        "-c",
        "--config",
        default=_default_config_path(),
        help="Config file (default: /etc/snmp/extension/<name>.conf)",
    )
    parser.add_argument(
        "-o",
        "--output",
        default="/run/snmp/extension/btrfs",
        help="Write JSON output to file (default: /run/snmp/extension/btrfs, use '-' for stdout)",
    )
    parser.add_argument(
        "--fstab",
        default="/etc/fstab",
        help="fstab path used for auto-generated config (default: /etc/fstab)",
    )
    parser.add_argument(
        "-z",
        "--gzip-base64",
        dest="gzip_base64",
        action="store_true",
        default=None,
        help="Write output as gzip+base64 (default from config; defaults to enabled)",
    )
    parser.add_argument("-h", "--help", action="store_true", help="Show help")
    ns, extra = parser.parse_known_args(args)
    if extra:
        emit_data({}, 1, f"Unknown arguments: {' '.join(extra)}", ns.output, True)
        return 1
    if ns.help:
        print(
            "Usage: btrfs [-c <config>] [-o <output>]\n"
            "\n"
            "Mountpoints are read from /etc/snmp/extension/btrfs.conf (or -c).\n"
            "Config format: one mountpoint per line, or 'label <mountpoint>'.\n"
            "Config option: 'compress true|false' (default: true).\n"
            "If config is missing/empty, it is auto-generated from btrfs lines in /etc/fstab.\n"
            "Default output is /run/snmp/extension/btrfs (use -o - for stdout).\n"
        )
        return 0

    if shutil.which("btrfs") is None:
        emit_data({}, 127, "btrfs command not found in PATH", ns.output, True)
        return 127

    targets = []
    compress = True
    try:
        cfg = _read_config(ns.config)
        targets = cfg["mounts"]
        compress = cfg["compress"]
    except FileNotFoundError:
        try:
            auto_mounts = _read_btrfs_mounts_from_fstab(ns.fstab)
        except OSError as e:
            emit_data({}, 1, f"Config not found: {ns.config}; failed reading {ns.fstab}: {e}", ns.output, True)
            return 1
        if not auto_mounts:
            emit_data({}, 1, f"Config not found: {ns.config}; no btrfs mountpoints in {ns.fstab}", ns.output, True)
            return 1
        try:
            _write_autogen_config(ns.config, auto_mounts)
            cfg = _read_config(ns.config)
            targets = cfg["mounts"]
            compress = cfg["compress"]
        except OSError as e:
            emit_data({}, 1, f"Config not found: {ns.config}; failed auto-generating config: {e}", ns.output, True)
            return 1
    except OSError as e:
        emit_data({}, 1, f"Failed to read config {ns.config}: {e}", ns.output, True)
        return 1

    if ns.gzip_base64 is True:
        compress = True

    if not targets:
        try:
            auto_mounts = _read_btrfs_mounts_from_fstab(ns.fstab)
        except OSError as e:
            emit_data({}, 1, f"No mountpoints configured; failed reading {ns.fstab}: {e}", ns.output, compress)
            return 1
        if not auto_mounts:
            emit_data({}, 1, f"No mountpoints configured and no btrfs mountpoints in {ns.fstab}", ns.output, compress)
            return 1
        try:
            _write_autogen_config(ns.config, auto_mounts)
            cfg = _read_config(ns.config)
            targets = cfg["mounts"]
            compress = True if ns.gzip_base64 is True else cfg["compress"]
        except OSError as e:
            emit_data({}, 1, f"Failed auto-generating config {ns.config}: {e}", ns.output, compress)
            return 1
        if not targets:
            emit_data({}, 1, "No mountpoints configured", ns.output, compress)
            return 1

    # Always collect version once.
    v_rc, v_out, v_err, v_proc = _run(["btrfs", "--version"])
    if v_rc != 0:
        emit_data({}, v_rc, proc_err(["btrfs", "--version"], v_proc), ns.output, compress)
        return v_rc
    btrfs_version = _parse_btrfs_version((v_out or v_err).strip())

    def collect_for_mount(mp):
        mp = mp.rstrip("/") or "/"
        fs = {"mountpoint": mp, "warnings": {}, "errors": {}}
        commands = [
            ("filesystem_show", ["btrfs", "filesystem", "show", "--raw", mp], _parse_filesystem_show),
            ("filesystem_usage_T", ["btrfs", "filesystem", "usage", "-b", "-T", mp], _parse_filesystem_usage_T),
            ("filesystem_usage_bytes", ["btrfs", "filesystem", "usage", "-b", mp], _parse_filesystem_usage_bytes),
            ("filesystem_df", ["btrfs", "filesystem", "df", "-b", mp], _parse_filesystem_df),
            ("device_stats", ["btrfs", "device", "stats", mp], _parse_device_stats),
        ]
        ok = 0
        first_err = None
        for key, argv, parse_fn in commands:
            rc, out, err, proc = _run(argv)
            if rc != 0:
                msg = proc_err(argv, proc)
                fs["errors"][key] = {"rc": rc, "message": msg, "stderr": (err or "").strip()}
                if first_err is None:
                    first_err = msg
                continue
            ok += 1
            if (err or "").strip():
                fs["warnings"][key] = err.strip()
            text = out.strip() if out.strip() else err.strip()
            fs[key] = parse_fn(text)
        return fs, ok, first_err

    # Backward compatible single-mount output.
    if len(targets) == 1:
        fs, ok, first_err = collect_for_mount(targets[0]["mountpoint"])
        data = {"btrfs_version": btrfs_version, **fs}
        if ok == 0:
            if not emit_data(data, 1, first_err or "all btrfs commands failed", ns.output, compress):
                return 1
            return 1
        if not emit_data(data, 0, "", ns.output, compress):
            return 1
        return 0

    # Multi-mount output.
    out = {
        "btrfs_version": btrfs_version,
        "filesystems": {},
    }
    total_ok = 0
    first_err = None
    for t in targets:
        fs, ok, ferr = collect_for_mount(t["mountpoint"])
        out["filesystems"][t["id"]] = fs
        total_ok += ok
        if first_err is None and ferr:
            first_err = ferr

    if total_ok == 0:
        if not emit_data(out, 1, first_err or "all btrfs commands failed", ns.output, compress):
            return 1
        return 1

    if not emit_data(out, 0, "", ns.output, compress):
        return 1
    return 0


