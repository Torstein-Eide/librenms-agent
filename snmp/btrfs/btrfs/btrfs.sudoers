# LibreNMS btrfs SNMP extend agent - sudoers configuration
# Allows the snmp user to run btrfs commands needed for monitoring

# btrfs filesystem commands
Cmnd_Alias BTRFS_FS = \
  /usr/bin/btrfs filesystem show --raw *, \
  /usr/bin/btrfs filesystem usage -b *, \
  /usr/bin/btrfs filesystem df *

# btrfs scrub commands
Cmnd_Alias BTRFS_SCRUB = \
  /usr/bin/btrfs scrub status *, \
  /usr/bin/btrfs scrub status --raw -d *, \
  /usr/bin/btrfs scrub status --raw -d -R *

# btrfs device commands
Cmnd_Alias BTRFS_DEV = \
  /usr/bin/btrfs device usage -b *, \
  /usr/bin/btrfs device stats *

# btrfs balance commands
Cmnd_Alias BTRFS_BALANCE = \
  /usr/bin/btrfs balance status *, \
  /usr/bin/btrfs -v balance status *

# btrfs subvolume commands
Cmnd_Alias BTRFS_SUBVOL = \
  /usr/bin/btrfs subvolume list *

# btrfs version
Cmnd_Alias BTRFS_VERSION = \
  /usr/bin/btrfs --version, \
  /usr/bin/btrfs version

# findmnt for mount detection
Cmnd_Alias FINDMNT = \
  /usr/bin/findmnt -no SOURCE -T *, \
  /usr/bin/findmnt -no UUID -T *

# Allow snmp user to run btrfs commands (Debian/Ubuntu)
Debian-snmp ALL=NOPASSWD: BTRFS_FS, BTRFS_SCRUB, BTRFS_DEV, BTRFS_BALANCE, BTRFS_SUBVOL, BTRFS_VERSION, FINDMNT

# RedHat/CentOS/Fedora - use 'snmp' user
#snmp ALL=NOPASSWD: BTRFS_FS, BTRFS_SCRUB, BTRFS_DEV, BTRFS_BALANCE, BTRFS_SUBVOL, BTRFS_VERSION, FINDMNT