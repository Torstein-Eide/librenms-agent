#!/usr/bin/env python3
import argparse
import base64
import gzip
import json
import logging
import os
import re
import shutil
import subprocess
import sys
import tempfile


VERSION = 1

LOGGER = logging.getLogger("btrfs")

logging.addLevelName(15, "VERBOSE")
logging.addLevelName(25, "NOTICE")


def _verbose(self, message, *args, **kwargs):
    if self.isEnabledFor(15):
        self._log(15, message, args, **kwargs)


def _notice(self, message, *args, **kwargs):
    if self.isEnabledFor(25):
        self._log(25, message, args, **kwargs)


logging.Logger.verbose = _verbose
logging.Logger.notice = _notice


def proc_err(argv, proc):
    cmd = " ".join(argv) if isinstance(argv, (list, tuple)) else str(argv)
    stderr = (proc.stderr or "").strip()
    first = stderr.splitlines()[0] if stderr else ""
    return f"{subprocess.CalledProcessError(proc.returncode, cmd, stderr)}{(' (' + first + ')') if first else ''}"


def print_data(data, error, error_msg):
    return json.dumps(
        {
            "data": data,
            "error": error,
            "errorString": error_msg,
            "version": VERSION,
        }
    )


def _gzip_base64(text):
    raw = text.encode("utf-8")
    return base64.b64encode(gzip.compress(raw)).decode("ascii")


def emit_data(data, error, error_msg, output_path=None, compress=False):
    payload = print_data(data, error, error_msg)
    if compress and error == 0:
        payload = _gzip_base64(payload)
    if error != 0 and error_msg:
        print(f"[btrfs] {error_msg}", file=sys.stderr)
    if not output_path or output_path == "-":
        print(payload)
        return True

    out_dir = os.path.dirname(output_path)
    temp_path = None
    try:
        if out_dir:
            os.makedirs(out_dir, exist_ok=True)
            LOGGER.verbose("ensured output directory exists: %s", out_dir)
        fd, temp_path = tempfile.mkstemp(prefix=".btrfs.", dir=(out_dir or None))
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(payload)
            f.write("\n")
        os.replace(temp_path, output_path)
        os.chmod(output_path, 0o755)
        LOGGER.notice("wrote output to: %s", output_path)
        return True
    except OSError as e:
        if temp_path and os.path.exists(temp_path):
            try:
                os.unlink(temp_path)
            except OSError:
                pass
        print(print_data({}, 1, f"Failed to write output {output_path}: {e}"))
        return False


def _default_config_path():
    # Use the documented extension layout.
    script = os.path.realpath(sys.argv[0])
    return f"/etc/snmp/extension/{os.path.basename(script)}.yaml"


def _parse_bool(value, default=True):
    if isinstance(value, bool):
        return value
    if value is None:
        return default
    val = str(value).strip().lower()
    if val in {"1", "true", "yes", "on"}:
        return True
    if val in {"0", "false", "no", "off"}:
        return False
    return default


def _read_config_yaml_text(text):
    try:
        import yaml  # type: ignore

        return yaml.safe_load(text)
    except ImportError:
        doc = {}
        mounts = []
        in_mounts = False
        for raw in text.splitlines():
            line = raw.split("#", 1)[0].rstrip()
            if not line.strip():
                continue
            stripped = line.strip()
            if stripped.startswith("compress:"):
                doc["compress"] = stripped.split(":", 1)[1].strip()
                in_mounts = False
                continue
            if stripped.startswith("gzip:"):
                doc["gzip"] = stripped.split(":", 1)[1].strip()
                in_mounts = False
                continue
            if stripped == "mounts:":
                in_mounts = True
                continue
            if in_mounts and stripped.startswith("- "):
                item = stripped[2:].strip()
                if item.startswith("{") and item.endswith("}"):
                    fields = {}
                    for part in item[1:-1].split(","):
                        if ":" not in part:
                            continue
                        k, v = part.split(":", 1)
                        fields[k.strip()] = v.strip().strip("\"'")
                    mounts.append(fields)
                elif item.startswith("id:"):
                    mounts.append({"id": item.split(":", 1)[1].strip().strip("\"'")})
                else:
                    mounts.append(item.strip("\"'"))
                continue
            if in_mounts and ":" in stripped and mounts and isinstance(mounts[-1], dict):
                k, v = stripped.split(":", 1)
                mounts[-1][k.strip()] = v.strip().strip("\"'")
        if mounts:
            doc["mounts"] = mounts
        return doc


def _read_config(path):
    # YAML format:
    # compress: true
    # mounts:
    #   - /mountpoint
    #   - { id: backup, mountpoint: /mnt/backup }
    #   - id: data
    #     mountpoint: /mnt/data
    with open(path, "r", encoding="utf-8") as f:
        data = _read_config_yaml_text(f.read())

    mounts = []
    if data is None:
        data = {}
    if not isinstance(data, dict):
        raise ValueError("config root must be a YAML mapping")

    compress = _parse_bool(data.get("compress", data.get("gzip", True)), True)
    output = data.get("output")
    raw_mounts = data.get("mounts", [])
    if isinstance(raw_mounts, str):
        raw_mounts = [raw_mounts]
    if not isinstance(raw_mounts, list):
        raise ValueError("'mounts' must be a YAML list")

    for item in raw_mounts:
        if isinstance(item, str):
            mp = item.strip()
            if mp:
                mounts.append({"id": mp, "mountpoint": mp})
            continue
        if isinstance(item, dict):
            mp = str(item.get("mountpoint", "")).strip()
            if not mp:
                mp = str(item.get("path", "")).strip()
            if not mp:
                continue
            item_id = str(item.get("id", mp)).strip() or mp
            mounts.append({"id": item_id, "mountpoint": mp})
    return {"mounts": mounts, "compress": compress, "output": output}


def _unescape_fstab_field(field):
    def repl(m):
        return chr(int(m.group(1), 8))

    return re.sub(r"\\([0-7]{3})", repl, field)


def _read_btrfs_mounts_from_fstab(path="/etc/fstab"):
    mounts = []
    seen = set()
    with open(path, "r", encoding="utf-8") as f:
        for ln in f:
            ln = ln.strip()
            if not ln or ln.startswith("#"):
                continue
            if "#" in ln:
                ln = ln.split("#", 1)[0].rstrip()
            if not ln:
                continue
            parts = ln.split()
            if len(parts) < 3:
                continue
            fs_vfstype = parts[2].strip().lower()
            if fs_vfstype != "btrfs":
                continue
            mountpoint = _unescape_fstab_field(parts[1].strip())
            if mountpoint and mountpoint not in seen:
                seen.add(mountpoint)
                mounts.append(mountpoint)
    return mounts


def _write_autogen_config(config_path, mountpoints):
    out_dir = os.path.dirname(config_path)
    temp_path = None
    if out_dir:
        try:
            os.makedirs(out_dir, exist_ok=True)
            LOGGER.verbose("ensured config directory exists: %s", out_dir)
        except OSError as e:
            LOGGER.notice("failed to create config directory %s: %s", out_dir, e)
            raise
    fd, temp_path = tempfile.mkstemp(prefix=".btrfs.config.", dir=(out_dir or None))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write("# Auto-generated from /etc/fstab (btrfs entries)\n")
            f.write("compress: true\n")
            f.write("mounts:\n")
            for mp in mountpoints:
                f.write(f"  - {mp}\n")
        os.replace(temp_path, config_path)
    except OSError:
        if temp_path and os.path.exists(temp_path):
            try:
                os.unlink(temp_path)
            except OSError:
                pass
        raise


def _run(argv):
    cmd_str = " ".join(argv) if isinstance(argv, (list, tuple)) else str(argv)
    LOGGER.debug("run: %s", cmd_str)
    proc = subprocess.run(argv, capture_output=True, text=True)
    LOGGER.debug("rc=%s", proc.returncode)
    if proc.stdout:
        LOGGER.debug("stdout: %s", proc.stdout[:500])
    if proc.stderr:
        LOGGER.debug("stderr: %s", proc.stderr[:500])
    return proc.returncode, (proc.stdout or ""), (proc.stderr or ""), proc


def _read_text_file(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def _read_int_file(path):
    s = _read_text_file(path)
    if not s:
        return None
    try:
        return int(s)
    except ValueError:
        return None


def _sysfs_block_info(devnode, _seen=None, follow_bcache=True):
    # Basic info from /sys/block/{dev} (fallback to /sys/class/block/{dev}).
    # devnode is typically /dev/sda, /dev/dm-0, /dev/bcache0, etc.
    if not devnode:
        return {}

    if _seen is None:
        _seen = set()

    raw = str(devnode)
    name = os.path.basename(raw)
    if raw.startswith("/dev/"):
        try:
            name = os.path.basename(os.path.realpath(raw))
        except OSError:
            name = os.path.basename(raw)

    # Prevent recursion loops (bcache backing device can be misreported/self-referential).
    if name in _seen:
        return {"devnode": raw, "name": name, "present": False, "skipped": "recursion"}
    _seen.add(name)

    sys_block = os.path.join("/sys/block", name)
    sys_class = os.path.join("/sys/class/block", name)
    sys_path = sys_block if os.path.isdir(sys_block) else (sys_class if os.path.isdir(sys_class) else "")

    if not sys_path:
        return {"devnode": raw, "name": name, "present": False}

    def parent_disk_name_from_sysfs(path):
        # For partitions, /sys/class/block/<part> resolves to .../block/<disk>/<part>
        # For whole disks, it resolves to .../block/<disk>
        try:
            real = os.path.realpath(path)
        except OSError:
            return ""
        parts = [p for p in real.split(os.sep) if p]
        if "block" not in parts:
            return ""
        idx = parts.index("block")
        if idx + 1 >= len(parts):
            return ""
        return parts[idx + 1]

    parent = parent_disk_name_from_sysfs(sys_path)
    parent_path = os.path.join("/sys/block", parent) if parent and os.path.isdir(os.path.join("/sys/block", parent)) else ""

    sectors = _read_int_file(os.path.join(sys_path, "size"))
    size_bytes = sectors * 512 if sectors is not None else None

    out = {
        "devnode": raw,
        "name": name,
        "present": True,
        "sysfs": sys_path,
        "size_bytes": size_bytes,
        "queue": {
            "logical_block_size": _read_int_file(os.path.join(sys_path, "queue/logical_block_size")),
            "physical_block_size": _read_int_file(os.path.join(sys_path, "queue/physical_block_size")),
            "rotational": _read_int_file(os.path.join(sys_path, "queue/rotational")),
            "discard_max_bytes": _read_int_file(os.path.join(sys_path, "queue/discard_max_bytes")),
            "discard_granularity": _read_int_file(os.path.join(sys_path, "queue/discard_granularity")),
        },
        "device": {
            "model": _read_text_file(os.path.join(sys_path, "device/model")) or None,
            "vendor": _read_text_file(os.path.join(sys_path, "device/vendor")) or None,
            "serial": _read_text_file(os.path.join(sys_path, "device/serial")) or None,
            "wwid": _read_text_file(os.path.join(sys_path, "device/wwid")) or None,
        },
    }

    # If this is a partition and some attributes are missing, fall back to the parent disk.
    if parent_path and parent != name:
        if out["device"].get("model") is None:
            out["device"]["model"] = _read_text_file(os.path.join(parent_path, "device/model")) or None
        if out["device"].get("vendor") is None:
            out["device"]["vendor"] = _read_text_file(os.path.join(parent_path, "device/vendor")) or None
        if out["device"].get("serial") is None:
            out["device"]["serial"] = _read_text_file(os.path.join(parent_path, "device/serial")) or None
        if out["device"].get("wwid") is None:
            out["device"]["wwid"] = _read_text_file(os.path.join(parent_path, "device/wwid")) or None

        for qk, qpath in {
            "logical_block_size": "queue/logical_block_size",
            "physical_block_size": "queue/physical_block_size",
            "rotational": "queue/rotational",
            "discard_max_bytes": "queue/discard_max_bytes",
            "discard_granularity": "queue/discard_granularity",
        }.items():
            if out["queue"].get(qk) is None:
                out["queue"][qk] = _read_int_file(os.path.join(parent_path, qpath))

    slaves_dir = os.path.join(sys_path, "slaves")
    if os.path.isdir(slaves_dir):
        try:
            out["slaves"] = sorted(os.listdir(slaves_dir))
        except OSError:
            out["slaves"] = []

    # bcache-specific details
    bcache_dir = os.path.join(sys_path, "bcache")
    if follow_bcache and os.path.isdir(bcache_dir):
        backing = _read_text_file(os.path.join(bcache_dir, "backing_dev_name")) or ""
        b_uuid = (
            _read_text_file(os.path.join(bcache_dir, "uuid"))
            or _read_text_file(os.path.join(bcache_dir, "cache_set_uuid"))
            or _read_text_file(os.path.join(bcache_dir, "set_uuid"))
            or ""
        )
        binfo = {
            "backing_dev_name": backing or None,
            "uuid": b_uuid or None,
        }
        if backing:
            backing_devnode = backing if backing.startswith("/dev/") else ("/dev/" + backing)
            try:
                backing_name = os.path.basename(os.path.realpath(backing_devnode))
            except OSError:
                backing_name = os.path.basename(backing_devnode)
            if backing_name == name:
                binfo["backing_device"] = {
                    "devnode": backing_devnode,
                    "name": backing_name,
                    "present": False,
                    "skipped": "recursion",
                }
            else:
                # The backing device itself may also expose /sys/.../bcache; don't follow it.
                binfo["backing_device"] = _sysfs_block_info(backing_devnode, _seen, follow_bcache=False)
        out["bcache"] = binfo

    return out


def _read_sysfs_metadata_uuid(uuid_hint):
    if not uuid_hint:
        return ""
    if not re.fullmatch(r"[0-9a-fA-F-]{36}", uuid_hint):
        return ""

    sysfs_root = f"/sys/fs/btrfs/{uuid_hint}"
    md_uuid = _read_text_file(f"{sysfs_root}/metadata_uuid")
    if md_uuid:
        return md_uuid
    if os.path.isdir(sysfs_root):
        return uuid_hint
    return ""


def _read_sysfs_devinfo(fs_uuid):
    if not fs_uuid or not re.fullmatch(r"[0-9a-fA-F-]{36}", fs_uuid):
        return {}

    root = f"/sys/fs/btrfs/{fs_uuid}/devinfo"
    if not os.path.isdir(root):
        return {}

    out = {}
    try:
        entries = sorted(os.listdir(root), key=lambda x: int(x) if x.isdigit() else x)
    except OSError:
        return {}

    for dev_id in entries:
        dev_path = os.path.join(root, dev_id)
        if not os.path.isdir(dev_path):
            continue

        item = {}
        for key in ("fsid", "in_fs_metadata", "missing", "replace_target", "scrub_speed_max", "writeable"):
            val = _read_text_file(os.path.join(dev_path, key))
            if val == "":
                continue
            item[key] = _to_scalar(val)

        stats_text = _read_text_file(os.path.join(dev_path, "error_stats"))
        if stats_text:
            stats = {}
            for ln in stats_text.splitlines():
                parts = ln.strip().split(None, 1)
                if len(parts) != 2:
                    continue
                stats[_norm_key(parts[0])] = _to_scalar(parts[1])
            if stats:
                item["error_stats"] = stats

        out[str(dev_id)] = item

    return out


def _configure_logging(level_name):
    if not level_name:
        level_name = "INFO"
    # Custom levels: VERBOSE=15, NOTICE=25
    level_map = {
        "DEBUG": logging.DEBUG,
        "VERBOSE": 15,
        "INFO": logging.INFO,
        "NOTICE": 25,
        "WARNING": logging.WARNING,
        "ERROR": logging.ERROR,
        "CRITICAL": logging.CRITICAL,
    }
    numeric_level = level_map.get(level_name.upper(), logging.INFO)
    logging.basicConfig(level=numeric_level, format="%(levelname)s: %(message)s")


def _to_scalar(value):
    v = value.strip()
    if not v:
        return ""
    if re.fullmatch(r"[+-]?\d+", v):
        try:
            return int(v)
        except ValueError:
            return v
    if re.fullmatch(r"[+-]?\d+\.\d+", v):
        try:
            return float(v)
        except ValueError:
            return v
    low = v.lower()
    if low in {"true", "yes", "on"}:
        return True
    if low in {"false", "no", "off"}:
        return False
    return v


def _norm_key(text):
    return re.sub(r"[^a-z0-9]+", "_", text.strip().lower()).strip("_")


def _normalize_id(value):
    # Keep IDs filename-safe and readable.
    s = re.sub(r"[^A-Za-z0-9._-]", "_", str(value))
    s = s.strip("_")
    return s if s else "id"


def _safe_int(value):
    if isinstance(value, bool) or value is None:
        return None
    if isinstance(value, int):
        return value
    if isinstance(value, float):
        return int(value)
    if isinstance(value, str):
        v = value.strip()
        if v == "":
            return None
        if re.fullmatch(r"[+-]?\d+", v):
            try:
                return int(v)
            except ValueError:
                return None
    return None


def _sum_numeric(values):
    total = 0
    for v in values:
        if isinstance(v, bool) or v is None:
            continue
        if isinstance(v, (int, float)):
            total += int(v)
            continue
        if isinstance(v, str) and re.fullmatch(r"[+-]?\d+", v.strip()):
            try:
                total += int(v.strip())
            except ValueError:
                pass
    return total


def _extract_bytes_scrubbed(scrub_status_data):
    if not isinstance(scrub_status_data, dict):
        return None, None
    b = scrub_status_data.get("bytes_scrubbed")
    if isinstance(b, dict):
        bytes_val = _safe_int(b.get("bytes"))
        progress = b.get("progress")
        return bytes_val, (float(progress) if isinstance(progress, (int, float)) else None)
    return _safe_int(b), None


def _pick_primary_fs(items):
    def _primary_score(fs):
        # Prefer the "real" mount of the filesystem (not a btrfs subvolume mount).
        # findmnt SOURCE for subvolume mounts commonly looks like: /dev/sdc[/@home]
        src = (((fs.get("commands") or {}).get("findmnt_source") or {}).get("data") or {}).get("source")
        src = src if isinstance(src, str) else ""
        score = 0
        if src and "[" not in src:
            score += 10
        if src.startswith("/dev/"):
            score += 1
        mp = fs.get("mountpoint")
        if isinstance(mp, str) and mp.rstrip("/") == "":
            score += 1
        if mp == "/":
            score += 1
        return score

    def key(item):
        fs_name, fs = item
        mp = str(fs.get("mountpoint") or fs_name or "")
        return (_primary_score(fs), -len(mp))

    return max(items, key=key)


def _merge_scrub_devices(basic_cmd, detailed_cmd):
    scrub_devs = {}
    basic_priority_fields = {"time_left", "eta", "total_to_scrub", "bytes_scrubbed", "rate", "error_summary"}

    for _cmd_name, cmd_data in [
        ("scrub_status_devices_basic", basic_cmd),
        ("scrub_status_devices", detailed_cmd),
    ]:
        if not isinstance(cmd_data, dict):
            continue
        sd = (cmd_data.get("data") or {}).get("devices")
        if not isinstance(sd, dict):
            continue
        for dev_path, dev_entry in sd.items():
            if not isinstance(dev_entry, dict):
                continue
            if dev_path not in scrub_devs:
                scrub_devs[dev_path] = dev_entry.copy()
                continue
            existing = scrub_devs[dev_path]
            if dev_entry.get("no_stats_available") and not existing.get("no_stats_available"):
                continue
            if dev_entry.get("has_stats") is False and existing.get("has_stats") is not False:
                continue
            merged = existing.copy()
            for k, v in dev_entry.items():
                if v is None:
                    continue
                if k in basic_priority_fields and k in merged and merged.get(k) is not None:
                    continue
                merged[k] = v
            scrub_devs[dev_path] = merged

    return scrub_devs


def _scrub_status_flags(scrub_devs):
    scrub_running = False
    scrub_has_error = False
    for _, entry in scrub_devs.items():
        if not isinstance(entry, dict):
            continue
        if str(entry.get("status") or "").strip().lower() in {"running", "in progress", "in_progress", "in-progress"}:
            scrub_running = True
        for k in (
            "read_errors",
            "csum_errors",
            "verify_errors",
            "uncorrectable_errors",
            "unverified_errors",
            "missing",
            "device_missing",
        ):
            v = entry.get(k)
            if isinstance(v, (int, float)) and float(v) > 0:
                scrub_has_error = True
                break
        if scrub_has_error:
            break
    return scrub_running, scrub_has_error


def _balance_status(bal_cmd):
    if not isinstance(bal_cmd, dict):
        return 2, False, None

    rc = _safe_int(bal_cmd.get("rc"))
    data = bal_cmd.get("data") if isinstance(bal_cmd.get("data"), dict) else {}
    lines = data.get("lines") if isinstance(data.get("lines"), list) else []
    balance_message = str(lines[0]) if lines else None

    if rc == 0:
        return 2, False, balance_message

    status = str(data.get("status") or "").strip().lower()
    running = data.get("running")
    balance_is_running = bool(running) if isinstance(running, bool) else (status == "running")
    if balance_is_running:
        return 1, True, balance_message
    if status in {"error", "failed", "failure"}:
        return 3, False, balance_message

    profiles_list = data.get("profiles") if isinstance(data.get("profiles"), list) else []
    return (0 if profiles_list else 2), False, balance_message


def _build_tables_from_filesystems(btrfs_version, filesystems):
    # Build a normalized table-oriented view under data.tables.
    # This is meant to match the database schema mapping used by LibreNMS-btrfs tooling.
    tables = {
        "filesystems": {},
        "filesystem_capacity": {},
        "filesystem_profiles": {},
        "devices": {},
        "backing_devices": {},
        "filesystem_devices": {},
        "scrub_status_filesystems": {},
        "scrub_status_devices": {},
        "balance_status_filesystems": {},
        "device_error_events": {},
    }

    # Group by filesystem UUID and choose a single primary mountpoint per UUID.
    fs_by_uuid = {}
    for fs_name, fs in (filesystems or {}).items():
        if not isinstance(fs, dict):
            continue
        fs_uuid = str(fs.get("uuid") or "").strip()
        if not fs_uuid:
            continue
        fs_by_uuid.setdefault(fs_uuid, []).append((fs_name, fs))

    for fs_uuid, items in fs_by_uuid.items():
        fs_name, fs = _pick_primary_fs(items)

        mountpoint = str(fs.get("mountpoint") or fs_name)

        fs_show = ((fs.get("commands") or {}).get("filesystem_show") or {}).get("data")
        if not isinstance(fs_show, dict):
            fs_show = {}
        label = fs_show.get("label")
        if label is None:
            label = ""
        label = str(label)

        total_devices = _safe_int(fs_show.get("total_devices"))
        bytes_used = _safe_int(fs_show.get("fs_bytes_used"))

        usage_data = ((fs.get("commands") or {}).get("filesystem_usage") or {}).get("data")
        if isinstance(usage_data, dict):
            overall = usage_data.get("overall")
            if isinstance(overall, dict):
                # Prefer usage.overall.used when available.
                used = _safe_int(overall.get("used"))
                if used is not None:
                    bytes_used = used

        tables["filesystems"][fs_uuid] = {
            "mountpoint": mountpoint,
            "label": label,
            "rrd_key": _normalize_id(mountpoint),
            "total_devices": total_devices,
            "bytes_used": bytes_used,
        }

        # Capacity
        overall = {}
        profiles = []
        unallocated = {}
        if isinstance(usage_data, dict):
            overall = usage_data.get("overall") if isinstance(usage_data.get("overall"), dict) else {}
            profiles = usage_data.get("profiles") if isinstance(usage_data.get("profiles"), list) else []
            unallocated = usage_data.get("unallocated") if isinstance(usage_data.get("unallocated"), dict) else {}

        free_est = overall.get("free_estimated") if isinstance(overall.get("free_estimated"), dict) else {}
        glob = overall.get("global_reserve") if isinstance(overall.get("global_reserve"), dict) else {}

        # Aggregate usage totals by class (sum per-device allocations).
        usage_by_path = {}
        for prof in profiles:
            if not isinstance(prof, dict):
                continue
            clazz = str(prof.get("class") or "").strip().lower()
            devmap = prof.get("devices") if isinstance(prof.get("devices"), dict) else {}
            for p, b in devmap.items():
                if not isinstance(p, str):
                    continue
                usage_by_path.setdefault(p, {"data": 0, "metadata": 0, "system": 0})
                if clazz in {"data", "metadata", "system"}:
                    usage_by_path[p][clazz] += _safe_int(b) or 0

        usage_data_total = sum(v["data"] for v in usage_by_path.values())
        usage_metadata_total = sum(v["metadata"] for v in usage_by_path.values())
        usage_system_total = sum(v["system"] for v in usage_by_path.values())

        # Scrub bytes scrubbed
        scrub_data = ((fs.get("commands") or {}).get("scrub_status") or {}).get("data")
        scrub_bytes, scrub_progress = _extract_bytes_scrubbed(scrub_data)

        # IO error totals from devinfo
        io_errors = 0
        devinfo = fs.get("devinfo")
        if isinstance(devinfo, dict):
            for _, di in devinfo.items():
                if not isinstance(di, dict):
                    continue
                es = di.get("error_stats")
                if not isinstance(es, dict):
                    continue
                io_errors += _sum_numeric(
                    [
                        es.get("write_errs"),
                        es.get("read_errs"),
                        es.get("flush_errs"),
                        es.get("corruption_errs"),
                        es.get("generation_errs"),
                    ]
                )

        # Status codes (0=OK, 1=Running, 2=N/A, 3=Error, 4=Missing)
        has_devinfo = isinstance(devinfo, dict) and len(devinfo) > 0
        has_show_devices = isinstance(fs_show.get("devices"), list) and len(fs_show.get("devices")) > 0

        missing_flag = False
        if isinstance(overall.get("device_missing"), (int, float)) and float(overall.get("device_missing")) > 0:
            missing_flag = True
        if isinstance(devinfo, dict):
            for _, di in devinfo.items():
                if isinstance(di, dict) and _safe_int(di.get("missing")) == 1:
                    missing_flag = True
                    break

        if not has_devinfo and not has_show_devices:
            io_status_code = 2
        elif missing_flag:
            io_status_code = 4
        else:
            io_status_code = 3 if io_errors > 0 else 0

        # Scrub status
        scrub_cmd = (fs.get("commands") or {}).get("scrub_status")
        scrub_dev_cmd = (fs.get("commands") or {}).get("scrub_status_devices")
        scrub_dev_cmd_basic = (fs.get("commands") or {}).get("scrub_status_devices_basic")
        has_scrub_data = isinstance(scrub_cmd, dict) or isinstance(scrub_dev_cmd, dict)

        # Merge device data: basic (-d) has time_left/eta/total_to_scrub/bytes_scrubbed/rate,
        # detailed (-R) has data_bytes_scrubbed/etc. Keep the more relevant fields from each.
        scrub_devs = _merge_scrub_devices(scrub_dev_cmd_basic, scrub_dev_cmd)
        scrub_running, scrub_has_error = _scrub_status_flags(scrub_devs)

        if not has_scrub_data:
            scrub_status_code = 2
        else:
            scrub_status_code = 3 if scrub_has_error else (1 if scrub_running else 0)

        # Balance
        bal_cmd = (fs.get("commands") or {}).get("balance_status")
        balance_status_code, balance_is_running, balance_message = _balance_status(bal_cmd)

        tables["filesystem_capacity"][fs_uuid] = {
            "device_size": _safe_int(overall.get("device_size")),
            "device_allocated": _safe_int(overall.get("device_allocated")),
            "device_unallocated": _safe_int(overall.get("device_unallocated")),
            "used": _safe_int(overall.get("used")),
            "free_estimated": _safe_int(free_est.get("bytes")) if isinstance(free_est, dict) else None,
            "free_estimated_min": _safe_int(free_est.get("min_bytes")) if isinstance(free_est, dict) else None,
            "free_statfs_df": _safe_int(overall.get("free_statfs_df")),
            "global_reserve": _safe_int(glob.get("bytes")) if isinstance(glob, dict) else None,
            "global_reserve_used": _safe_int(glob.get("used_bytes")) if isinstance(glob, dict) else None,
            "device_missing": _safe_int(overall.get("device_missing")),
            "device_slack": _safe_int(overall.get("device_slack")),
            "data_ratio": overall.get("data_ratio"),
            "metadata_ratio": overall.get("metadata_ratio"),
            "usage_data": usage_data_total,
            "usage_metadata": usage_metadata_total,
            "usage_system": usage_system_total,
            "scrub_bytes_scrubbed": scrub_bytes,
            "io_status_code": io_status_code,
            "scrub_status_code": scrub_status_code,
            "balance_status_code": balance_status_code,
            "io_errors": io_errors,
        }

        # Filesystem profiles from device_usage dynamic keys.
        type_totals = {}
        dev_usage = ((fs.get("commands") or {}).get("device_usage") or {}).get("data")
        dev_entries = dev_usage.get("devices") if isinstance(dev_usage, dict) else []
        if isinstance(dev_entries, list):
            for entry in dev_entries:
                if not isinstance(entry, dict):
                    continue
                for k, v in entry.items():
                    if not isinstance(k, str):
                        continue
                    if not (k.startswith("data_") or k.startswith("metadata_") or k.startswith("system_")):
                        continue
                    if not isinstance(v, (int, float)):
                        continue
                    type_totals[k] = type_totals.get(k, 0) + int(v)
        prof_list = [{"profile": k, "bytes": type_totals[k]} for k in sorted(type_totals.keys())]
        tables["filesystem_profiles"][fs_uuid] = prof_list

        # Devices + per-filesystem devices
        show_devices = fs_show.get("devices") if isinstance(fs_show.get("devices"), list) else []
        path_to_devid = {}
        show_by_devid = {}
        for d in show_devices:
            if not isinstance(d, dict):
                continue
            p = d.get("path")
            did = d.get("devid")
            if isinstance(p, str) and did is not None:
                path_to_devid[p] = str(did)
                show_by_devid[str(did)] = d

        fs_dev_rows = {}

        # sys_block metadata flatten (merge from all mountpoints for this UUID)
        merged_sys_block = {}
        for _name, _fs in items:
            if not isinstance(_fs, dict):
                continue
            sb = _fs.get("sys_block") if isinstance(_fs.get("sys_block"), dict) else {}
            for k, v in sb.items():
                if k not in merged_sys_block:
                    merged_sys_block[k] = v

        for dev_path, entry in merged_sys_block.items():
            if not isinstance(entry, dict):
                continue
            primary_path = entry.get("devnode") if isinstance(entry.get("devnode"), str) else str(dev_path)
            dev_name = entry.get("name")
            identity = entry.get("device") if isinstance(entry.get("device"), dict) else {}
            tables["devices"][primary_path] = {
                "device_name": dev_name,
                "model": identity.get("model"),
            }

            bcache = entry.get("bcache") if isinstance(entry.get("bcache"), dict) else None
            if isinstance(bcache, dict):
                backing = bcache.get("backing_device") if isinstance(bcache.get("backing_device"), dict) else {}
                backing_path = backing.get("devnode") if isinstance(backing.get("devnode"), str) else None
                if backing_path:
                    backing_identity = backing.get("device") if isinstance(backing.get("device"), dict) else {}
                    tables["devices"][backing_path] = {
                        "device_name": backing.get("name"),
                        "model": backing_identity.get("model"),
                    }

                # backing_devices table keyed by bcache device path
                devid = path_to_devid.get(primary_path)
                if devid:
                    tables["backing_devices"][primary_path] = {
                        "fs_uuid": fs_uuid,
                        "devid": devid,
                        "backing_device_path": backing_path,
                        "backing_device_name": backing.get("name") if isinstance(backing, dict) else bcache.get("backing_dev_name"),
                        "present": backing.get("present") if isinstance(backing, dict) else None,
                        "size_bytes": backing.get("size_bytes") if isinstance(backing, dict) else None,
                        "model": (backing.get("device") or {}).get("model") if isinstance(backing, dict) else None,
                    }

        # filesystem_devices keyed by fs_uuid then devid
        unalloc_map = unallocated if isinstance(unallocated, dict) else {}
        for devid, show_entry in show_by_devid.items():
            if not isinstance(show_entry, dict):
                continue
            dev_path = show_entry.get("path")
            if not isinstance(dev_path, str) or not dev_path:
                continue
            missing = False
            di = devinfo.get(devid) if isinstance(devinfo, dict) else None
            if isinstance(di, dict) and _safe_int(di.get("missing")) == 1:
                missing = True

            # usage bytes per class
            per = usage_by_path.get(dev_path, {"data": 0, "metadata": 0, "system": 0})

            # errors
            es = di.get("error_stats") if isinstance(di, dict) else {}
            if not isinstance(es, dict):
                es = {}

            row = {
                "device_path": dev_path,
                "missing": missing,
                "size": _safe_int(show_entry.get("size")),
                "unallocated": _safe_int(unalloc_map.get(dev_path)),
                "data": per.get("data", 0),
                "metadata": per.get("metadata", 0),
                "system": per.get("system", 0),
                "write_io_errs": _safe_int(es.get("write_errs")),
                "read_io_errs": _safe_int(es.get("read_errs")),
                "flush_io_errs": _safe_int(es.get("flush_errs")),
                "corruption_errs": _safe_int(es.get("corruption_errs")),
                "generation_errs": _safe_int(es.get("generation_errs")),
            }

            # bcache backing path if available
            sys_entry = merged_sys_block.get(dev_path)
            if isinstance(sys_entry, dict):
                bcache = sys_entry.get("bcache") if isinstance(sys_entry.get("bcache"), dict) else None
                if isinstance(bcache, dict):
                    backing = bcache.get("backing_device") if isinstance(bcache.get("backing_device"), dict) else {}
                    backing_path = backing.get("devnode") if isinstance(backing.get("devnode"), str) else None
                    if backing_path:
                        row["backing_device_path"] = backing_path

            fs_dev_rows[devid] = row

        tables["filesystem_devices"][fs_uuid] = fs_dev_rows

        # scrub_status_filesystems
        scrub_entry = {}
        if isinstance(scrub_data, dict):
            scrub_entry = {
                "status": scrub_data.get("status"),
                "scrub_started": scrub_data.get("scrub_started"),
                "duration": scrub_data.get("duration"),
                "time_left": scrub_data.get("time_left"),
                "eta": scrub_data.get("eta"),
                "total_to_scrub": scrub_data.get("total_to_scrub"),
                "bytes_scrubbed": scrub_bytes,
                "progress_percent": scrub_progress,
                "rate": scrub_data.get("rate"),
                "error_summary": scrub_data.get("error_summary"),
                "is_running": scrub_running,
            }
        tables["scrub_status_filesystems"][fs_uuid] = scrub_entry

        # scrub_status_devices - per-device scrub status keyed by devid
        scrub_dev_table = {}
        for dev_path, dev_entry in scrub_devs.items():
            if not isinstance(dev_entry, dict):
                continue
            dev_id = dev_entry.get("id")
            if dev_id is None:
                continue
            row = {
                "path": dev_entry.get("path"),
                "status": dev_entry.get("status"),
                "scrub_started": dev_entry.get("scrub_started"),
                "duration": dev_entry.get("duration"),
            }
            if dev_entry.get("time_left") is not None:
                row["time_left"] = dev_entry.get("time_left")
            if dev_entry.get("eta") is not None:
                row["eta"] = dev_entry.get("eta")
            if dev_entry.get("total_to_scrub") is not None:
                row["total_to_scrub"] = _safe_int(dev_entry.get("total_to_scrub"))
            scrub_bytes = dev_entry.get("bytes_scrubbed")
            if isinstance(scrub_bytes, dict):
                row["bytes_scrubbed"] = _safe_int(scrub_bytes.get("bytes"))
                row["progress_percent"] = _safe_int(scrub_bytes.get("progress"))
            elif scrub_bytes is not None:
                row["bytes_scrubbed"] = _safe_int(scrub_bytes)
            if dev_entry.get("rate") is not None:
                row["rate"] = dev_entry.get("rate")
            row.update({
                "data_extents_scrubbed": _safe_int(dev_entry.get("data_extents_scrubbed")),
                "tree_extents_scrubbed": _safe_int(dev_entry.get("tree_extents_scrubbed")),
                "data_bytes_scrubbed": _safe_int(dev_entry.get("data_bytes_scrubbed")),
                "tree_bytes_scrubbed": _safe_int(dev_entry.get("tree_bytes_scrubbed")),
                "read_errors": _safe_int(dev_entry.get("read_errors")),
                "csum_errors": _safe_int(dev_entry.get("csum_errors")),
                "verify_errors": _safe_int(dev_entry.get("verify_errors")),
                "no_csum": _safe_int(dev_entry.get("no_csum")),
                "csum_discards": _safe_int(dev_entry.get("csum_discards")),
                "super_errors": _safe_int(dev_entry.get("super_errors")),
                "malloc_errors": _safe_int(dev_entry.get("malloc_errors")),
                "corrected_errors": _safe_int(dev_entry.get("corrected_errors")),
                "uncorrectable_errors": _safe_int(dev_entry.get("uncorrectable_errors")),
                "unverified_errors": _safe_int(dev_entry.get("unverified_errors")),
                "last_physical": _safe_int(dev_entry.get("last_physical")),
            })
            scrub_dev_table[str(dev_id)] = row
        tables["scrub_status_devices"][fs_uuid] = scrub_dev_table

        # balance_status_filesystems
        tables["balance_status_filesystems"][fs_uuid] = {
            "is_running": balance_is_running,
            "message": balance_message,
        }

    return {"tables": tables}


def _parse_human_bytes(value):
    s = value.strip()
    if re.fullmatch(r"\d+", s):
        return int(s)
    m = re.match(r"^([0-9]+(?:\.[0-9]+)?)\s*([KMGTPE]?i?B)$", s)
    if not m:
        return None
    num = float(m.group(1))
    unit = m.group(2)
    factors = {
        "B": 1,
        "KiB": 1024,
        "MiB": 1024**2,
        "GiB": 1024**3,
        "TiB": 1024**4,
        "PiB": 1024**5,
        "EiB": 1024**6,
        "KB": 1000,
        "MB": 1000**2,
        "GB": 1000**3,
        "TB": 1000**4,
        "PB": 1000**5,
        "EB": 1000**6,
    }
    mul = factors.get(unit)
    if mul is None:
        return None
    return int(num * mul)


def _parse_bytes_with_detail(value, label):
    s = value.strip()
    m = re.match(rf"^(\d+)\s*\({label}:\s*(\d+)\)\s*$", s, re.IGNORECASE)
    if not m:
        return _to_scalar(s)
    return {
        "bytes": int(m.group(1)),
        f"{_norm_key(label)}_bytes": int(m.group(2)),
    }


def _parse_bytes_with_pct(value):
    s = value.strip()
    m = re.match(r"^(\d+)\s*\(([0-9.]+)%\)\s*$", s)
    if not m:
        return _to_scalar(s)
    return {"bytes": int(m.group(1)), "pct": float(m.group(2))}


def _parse_usage_value(key, value):
    if key == "free_estimated":
        return _parse_bytes_with_detail(value, "min")
    if key == "global_reserve":
        return _parse_bytes_with_detail(value, "used")
    if key == "used":
        return _parse_bytes_with_pct(value)
    return _to_scalar(value)


def _parse_scrub_value(key, value):
    s = value.strip()
    if key in {"total_to_scrub", "time_left"}:
        b = _parse_human_bytes(s)
        return b if b is not None else _to_scalar(s)

    if key in {"eta", "scrub_started", "duration", "rate", "status"}:
        return _to_scalar(s)

    if key == "bytes_scrubbed":
        m = re.match(r"^([0-9]+(?:\.[0-9]+)?\s*[KMGTPE]?i?B)\s*\(([0-9.]+)%\)\s*$", s)
        if m:
            b = _parse_human_bytes(m.group(1))
            if b is not None:
                return {"bytes": b, "progress": float(m.group(2))}
        b = _parse_human_bytes(s)
        return b if b is not None else _to_scalar(s)

    if key in {
        "data_extents_scrubbed",
        "tree_extents_scrubbed",
        "data_bytes_scrubbed",
        "tree_bytes_scrubbed",
        "no_csum",
        "csum_discards",
        "super_errors",
        "malloc_errors",
        "corrected_errors",
        "last_physical",
    }:
        b = _parse_human_bytes(s)
        return b if b is not None else _safe_int(s)

    return _to_scalar(s)


def _version_to_json(text):
    lines = [ln.strip() for ln in (text or "").splitlines() if ln.strip()]
    out = {"raw": text.strip()}
    if lines:
        m = re.search(r"btrfs-progs\s+v(\S+)", lines[0])
        if m:
            out["version"] = m.group(1)
        if len(lines) > 1:
            out["features"] = lines[1].split()
    return out


def _command_text_to_json(command, text):
    lines = [ln.rstrip("\n") for ln in (text or "").splitlines()]

    if command == "filesystem_show":
        out = {"devices": []}
        for ln in lines:
            s = ln.strip()
            m = re.search(r"\buuid:\s+([0-9a-fA-F-]+)", s)
            if m:
                out["uuid"] = m.group(1)
            m = re.search(r"Label:\s+(?:'([^']*)'|(\S+))", s)
            if m:
                label = m.group(1) if m.group(1) is not None else m.group(2)
                out["label"] = "" if str(label).strip().lower() == "none" else label
                continue
            m = re.search(r"Total devices\s+(\d+)\s+FS bytes used\s+(\d+)", s)
            if m:
                out["total_devices"] = int(m.group(1))
                out["fs_bytes_used"] = int(m.group(2))
                continue
            m = re.match(r"devid\s+(\d+)\s+size\s+(\d+)\s+used\s+(\d+)\s+path\s+(.+)$", s)
            if m:
                out["devices"].append(
                    {
                        "devid": int(m.group(1)),
                        "size": int(m.group(2)),
                        "used": int(m.group(3)),
                        "path": m.group(4).strip(),
                    }
                )
        return out

    if command == "findmnt_uuid":
        for ln in lines:
            s = ln.strip()
            if s:
                return {"uuid": s}
        return {}

    if command == "findmnt_source":
        for ln in lines:
            s = ln.strip()
            if s:
                # SOURCE may include btrfs subvol suffix like: /dev/sdc[/@home]
                source_device = s.split("[", 1)[0].strip()
                return {"source": s, "source_device": source_device}
        return {}

    if command == "device_stats":
        devices = {}
        for ln in lines:
            m = re.match(r"^\[([^\]]+)\]\.([A-Za-z0-9_]+)\s+([+-]?\d+)\s*$", ln.strip())
            if not m:
                continue
            dev = m.group(1)
            key = _norm_key(m.group(2))
            devices.setdefault(dev, {})[key] = int(m.group(3))
        return {"devices": devices}

    if command == "filesystem_usage":
        out = {"overall": {}, "profiles": [], "unallocated": {}}
        in_overall = False
        in_unallocated = False
        current_profile = None

        for ln in lines:
            s = ln.strip()
            if not s:
                if current_profile is not None:
                    current_profile = None
                continue
            if s == "Overall:":
                in_overall = True
                in_unallocated = False
                current_profile = None
                continue
            if s == "Unallocated:":
                in_overall = False
                in_unallocated = True
                current_profile = None
                continue

            m = re.match(r"^([A-Za-z]+),([^:]+):\s*(.*)$", s)
            if m:
                in_overall = False
                in_unallocated = False
                profile = {"class": m.group(1), "profile": m.group(2), "devices": {}}
                for part in m.group(3).split(","):
                    if ":" in part:
                        k, v = part.split(":", 1)
                        nk = _norm_key(k)
                        profile[nk] = _parse_usage_value(nk, v)
                    elif "=" in part:
                        k, v = part.split("=", 1)
                        nk = _norm_key(k)
                        profile[nk] = _parse_usage_value(nk, v)
                out["profiles"].append(profile)
                current_profile = profile
                continue

            m = re.match(r"^([^:]+):\s*(.*)$", s)
            if in_overall and m:
                nk = _norm_key(m.group(1))
                out["overall"][nk] = _parse_usage_value(nk, m.group(2))
                continue

            m = re.match(r"^(\S+)\s+(\d+)\s*$", s)
            if current_profile is not None and m:
                current_profile["devices"][m.group(1)] = int(m.group(2))
                continue

            if in_unallocated and m:
                out["unallocated"][m.group(1)] = int(m.group(2))

        # Safety net: some profile-like lines may still land in overall.
        for k in list(out["overall"].keys()):
            v = out["overall"][k]
            if not isinstance(v, str):
                continue
            mk = re.match(r"^(data|metadata|system)_([a-z0-9_]+)$", k)
            if not mk:
                continue
            if "size:" not in v.lower() and "used:" not in v.lower():
                continue

            profile = {
                "class": mk.group(1).capitalize(),
                "profile": mk.group(2).upper(),
                "devices": {},
            }
            for part in v.split(","):
                if ":" in part:
                    pk, pv = part.split(":", 1)
                    nk = _norm_key(pk)
                    profile[nk] = _parse_usage_value(nk, pv)
                elif "=" in part:
                    pk, pv = part.split("=", 1)
                    nk = _norm_key(pk)
                    profile[nk] = _parse_usage_value(nk, pv)

            out["profiles"].append(profile)
            del out["overall"][k]

        return out

    if command in {"scrub_status", "scrub_status_devices"}:
        out = {"devices": {}}
        current = None
        for ln in lines:
            s = ln.strip()
            m = re.match(r"^UUID:\s*(\S+)\s*$", s)
            if m:
                out["uuid"] = m.group(1)
                continue
            m = re.match(r"^Scrub device\s+(\S+)\s+\(id\s+(\d+)\)(?:\s+(status|history))?\s*$", s)
            if m:
                current = {
                    "path": m.group(1),
                    "id": int(m.group(2)),
                    "section": (m.group(3) or "").lower() or None,
                    "has_status_suffix": (m.group(3) or "").lower() == "status",
                    "has_stats": None,
                }
                out["devices"][m.group(1)] = current
                continue
            m = re.match(r"^([^:]+):\s*(.*)$", s)
            if m:
                key = _norm_key(m.group(1))
                val = _parse_scrub_value(key, m.group(2))
                if current is None:
                    out[key] = val
                else:
                    current[key] = val
                    if key != "path" and key != "id":
                        current["has_stats"] = True
                continue
            if current is not None and s.lower() == "no stats available":
                current["no_stats_available"] = True
                current["has_stats"] = False
                out["partial"] = True

        for dev in out["devices"].values():
            if dev.get("has_stats") is None:
                dev["has_stats"] = False
        return out

    if command == "device_usage":
        out = {"devices": []}
        current = None
        for ln in lines:
            s = ln.strip()
            m = re.match(r"^(\S+),\s*ID:\s*(\d+)\s*$", s)
            if m:
                current = {"path": m.group(1), "id": int(m.group(2))}
                out["devices"].append(current)
                continue
            if current is None:
                continue
            m = re.match(r"^([^:]+):\s*(.*)$", s)
            if m:
                current[_norm_key(m.group(1))] = _to_scalar(m.group(2))
        return out

    if command == "balance_status":
        out = {"lines": [ln for ln in lines if ln.strip()], "profiles": []}
        for ln in lines:
            s = ln.strip()
            if not s:
                continue
            m = re.match(r"^Balance on '([^']+)' is (.+)$", s)
            if m:
                out["path"] = m.group(1)
                out["status"] = m.group(2)
                continue
            m = re.match(
                r"^(\d+) out of about (\d+) chunks balanced \((\d+) considered\),\s+([0-9]+)% left$",
                s,
            )
            if m:
                out["progress"] = {
                    "chunks_balanced": int(m.group(1)),
                    "chunks_total_estimate": int(m.group(2)),
                    "chunks_considered": int(m.group(3)),
                    "percent_left": int(m.group(4)),
                }
                continue
            m = re.match(r"^Dumping filters: flags (0x[0-9a-fA-F]+), state (0x[0-9a-fA-F]+), force is (.+)$", s)
            if m:
                out["filters"] = {
                    "flags": m.group(1),
                    "state": m.group(2),
                    "force": m.group(3),
                }
                continue
            m = re.match(r"^([A-Z]+) \(flags (0x[0-9a-fA-F]+)\):\s*(.+)$", s)
            if m:
                out["profiles"].append(
                    {
                        "class": m.group(1),
                        "flags": m.group(2),
                        "status": m.group(3),
                    }
                )
        return out

    return {"lines": lines}


def _run_structured(command, argv):
    cmd_str = " ".join(argv)
    LOGGER.verbose("run command: %s", cmd_str)

    if argv and argv[0] == "btrfs":
        j_argv = ["btrfs", "--format", "json", *argv[1:]]
        j_rc, j_out, j_err, _ = _run(j_argv)
        if j_rc == 0:
            j_text = (j_out or j_err).strip()
            if j_text:
                try:
                    data = json.loads(j_text)
                    LOGGER.verbose("command OK: %s (json)", command)
                    return j_rc, j_out, j_err, "native", data
                except json.JSONDecodeError:
                    LOGGER.verbose("json parse failed, falling back to text")
        else:
            LOGGER.verbose("json mode failed rc=%s, falling back to text", j_rc)

    rc, out, err, _ = _run(argv)
    text = (out or err).strip()
    data = _command_text_to_json(command, text)

    if rc == 0:
        LOGGER.verbose("command OK: %s", command)
    else:
        LOGGER.notice("command failed: %s (rc=%s)", command, rc)

    return rc, out, err, "converted", data


def _resolve_fs_uuid(findmnt_uuid, show_uuid, scrub_uuid, scrub_devices_uuid):
    sysfs_uuid = _read_sysfs_metadata_uuid(findmnt_uuid or show_uuid or scrub_uuid or scrub_devices_uuid)
    if sysfs_uuid:
        return sysfs_uuid, "sysfs"
    if findmnt_uuid:
        return findmnt_uuid, "findmnt"
    if show_uuid:
        return show_uuid, "filesystem_show"
    if scrub_uuid:
        return scrub_uuid, "scrub_status"
    if scrub_devices_uuid:
        return scrub_devices_uuid, "scrub_status_devices"
    return "", ""


def main(args):
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "-c",
        "--config",
        default=_default_config_path(),
        help="Config file (default: /etc/snmp/extension/<name>.yaml)",
    )
    parser.add_argument(
        "-o",
        "--output",
        default="/run/snmp/extension/btrfs",
        help="Write JSON output to file (default: /run/snmp/extension/btrfs, use '-' for stdout)",
    )
    parser.add_argument(
        "--fstab",
        default="/etc/fstab",
        help="fstab path used for auto-generated config (default: /etc/fstab)",
    )
    parser.add_argument(
        "-z",
        "--gzip-base64",
        dest="gzip_base64",
        action="store_true",
        default=None,
        help="Write output as gzip+base64 (default from config; defaults to enabled)",
    )
    compress_group = parser.add_mutually_exclusive_group()
    compress_group.add_argument(
        "--compress",
        dest="compress_override",
        action="store_const",
        const=True,
        default=None,
        help="Force gzip+base64 compression on",
    )
    compress_group.add_argument(
        "--no-compress",
        dest="compress_override",
        action="store_const",
        const=False,
        default=None,
        help="Force gzip+base64 compression off",
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="store_const",
        const="DEBUG",
        dest="log",
        help="Set log level to DEBUG (verbose)",
    )
    parser.add_argument(
        "--log",
        default="INFO",
        choices=["DEBUG", "VERBOSE", "INFO", "NOTICE", "WARNING", "ERROR", "CRITICAL"],
        help="Set the logging threshold (default: %(default)s)",
    )
    parser.add_argument("-i", "--intermediate-json", dest="intermediate_json", default=None, help="Write intermediate JSON to file (default: ./tmp/intermediate.json)")
    ns, extra = parser.parse_known_args(args)
    _configure_logging(ns.log)
    LOGGER.notice("starting btrfs agent")
    if extra:
        emit_data({}, 1, f"Unknown arguments: {' '.join(extra)}", ns.output, True)
        return 1

    if shutil.which("btrfs") is None:
        emit_data({"errors": {"tool": "btrfs command not found in PATH"}}, 127, "btrfs command not found in PATH", ns.output, True)
        return 127

    LOGGER.verbose("config=%s fstab=%s", ns.config, ns.fstab)

    targets = []
    compress = True
    output_from_config = None
    try:
        cfg = _read_config(ns.config)
        targets = cfg["mounts"]
        compress = cfg["compress"]
        output_from_config = cfg.get("output")
        LOGGER.notice("loaded config: %d mount(s), compress=%s", len(targets), compress)
        if output_from_config:
            LOGGER.notice("output from config: %s", output_from_config)
    except FileNotFoundError:
        try:
            auto_mounts = _read_btrfs_mounts_from_fstab(ns.fstab)
        except OSError as e:
            emit_data({}, 1, f"Config not found: {ns.config}; failed reading {ns.fstab}: {e}", ns.output, True)
            return 1
        if not auto_mounts:
            emit_data({}, 1, f"Config not found: {ns.config}; no btrfs mountpoints in {ns.fstab}", ns.output, True)
            return 1
        try:
            LOGGER.notice("auto-generating config from %s", ns.fstab)
            _write_autogen_config(ns.config, auto_mounts)
            cfg = _read_config(ns.config)
            targets = cfg["mounts"]
            compress = cfg["compress"]
        except OSError as e:
            emit_data({}, 1, f"Config not found: {ns.config}; failed auto-generating config: {e}", ns.output, True)
            return 1
    except (OSError, ValueError) as e:
        emit_data({}, 1, f"Failed to read config {ns.config}: {e}", ns.output, True)
        return 1

    if ns.gzip_base64 is True:
        compress = True
        LOGGER.notice("compression forced on by -z")
    if ns.compress_override is not None:
        compress = bool(ns.compress_override)
        LOGGER.notice("compression override=%s", compress)

    if output_from_config and ns.output == "/run/snmp/extension/btrfs":
        ns.output = output_from_config
        LOGGER.notice("using output from config: %s", ns.output)

    if not targets:
        try:
            auto_mounts = _read_btrfs_mounts_from_fstab(ns.fstab)
        except OSError as e:
            emit_data({}, 1, f"No mountpoints configured; failed reading {ns.fstab}: {e}", ns.output, compress)
            return 1
        if not auto_mounts:
            emit_data({}, 1, f"No mountpoints configured and no btrfs mountpoints in {ns.fstab}", ns.output, compress)
            return 1
        try:
            LOGGER.notice("config empty, regenerating from %s", ns.fstab)
            _write_autogen_config(ns.config, auto_mounts)
            cfg = _read_config(ns.config)
            targets = cfg["mounts"]
            compress = True if ns.gzip_base64 is True else cfg["compress"]
        except OSError as e:
            emit_data({}, 1, f"Failed auto-generating config {ns.config}: {e}", ns.output, compress)
            return 1
        if not targets:
            emit_data({}, 1, "No mountpoints configured", ns.output, compress)
            return 1

    LOGGER.notice("processing %s", [t["mountpoint"] for t in targets])

    # Always collect version once.
    v_rc, v_out, v_err, v_proc = _run(["btrfs", "--version"])
    if v_rc != 0:
        emit_data({}, v_rc, proc_err(["btrfs", "--version"], v_proc), ns.output, compress)
        return v_rc
    btrfs_version = _version_to_json((v_out or v_err).strip())

    def collect_for_mount(mp):
        mp = mp.rstrip("/") or "/"
        LOGGER.notice("collecting mount: %s", mp)
        fs = {"mountpoint": mp, "commands": {}, "errors": {}, "sys_block": {}}
        commands = [
            ("filesystem_show", ["btrfs", "filesystem", "show", "--raw", mp]),
            ("findmnt_source", ["findmnt", "-no", "SOURCE", "-T", mp]),
            ("findmnt_uuid", ["findmnt", "-no", "UUID", "-T", mp]),
            ("filesystem_usage", ["btrfs", "filesystem", "usage", "-b", mp]),
            ("scrub_status", ["btrfs", "scrub", "status", mp]),
            ("scrub_status_devices_basic", ["btrfs", "scrub", "status", "--raw", "-d", mp]),
            ("scrub_status_devices", ["btrfs", "scrub", "status", "--raw", "-d", "-R", mp]),
            ("device_usage", ["btrfs", "device", "usage", "-b", mp]),
            ("balance_status", ["btrfs", "-v", "balance", "status", mp]),
        ]
        ok = 0
        first_err = None
        for key, argv in commands:
            rc, _out, err, out_format, data = _run_structured(key, argv)
            entry = {"rc": rc, "format": out_format, "data": data}
            stderr = (err or "").strip()
            if stderr:
                entry["stderr"] = stderr
            tolerated = False
            if key == "balance_status" and isinstance(data, dict):
                tolerated = bool(data.get("status") or data.get("progress") or data.get("lines"))

            if rc != 0 and not tolerated:
                msg = stderr or f"command failed with exit status {rc}"
                entry["error"] = msg
                fs["errors"][key] = {"rc": rc, "message": msg, "stderr": stderr}
                if first_err is None:
                    first_err = msg
            else:
                ok += 1
            fs["commands"][key] = entry

        show_data = fs["commands"].get("filesystem_show", {}).get("data")
        show_uuid = ""
        if isinstance(show_data, dict):
            show_uuid = str(show_data.get("uuid", "") or "")

        findmnt_data = fs["commands"].get("findmnt_uuid", {}).get("data")
        findmnt_uuid = ""
        if isinstance(findmnt_data, dict) and findmnt_data.get("uuid"):
            findmnt_uuid = str(findmnt_data.get("uuid") or "")

        scrub_data = fs["commands"].get("scrub_status", {}).get("data")
        scrub_uuid = ""
        if isinstance(scrub_data, dict) and scrub_data.get("uuid"):
            scrub_uuid = str(scrub_data.get("uuid") or "")

        scrub_devices_data = fs["commands"].get("scrub_status_devices", {}).get("data")
        scrub_devices_uuid = ""
        if isinstance(scrub_devices_data, dict) and scrub_devices_data.get("uuid"):
            scrub_devices_uuid = str(scrub_devices_data.get("uuid") or "")

        fs_uuid, fs_uuid_source = _resolve_fs_uuid(findmnt_uuid, show_uuid, scrub_uuid, scrub_devices_uuid)

        if fs_uuid:
            LOGGER.verbose("uuid source for %s: %s", mp, fs_uuid_source)
            fs["uuid"] = fs_uuid
            fs["uuid_source"] = fs_uuid_source
            if isinstance(show_data, dict) and not show_data.get("uuid"):
                show_data["uuid"] = fs_uuid

            sysfs_devinfo = _read_sysfs_devinfo(fs_uuid)
            if sysfs_devinfo:
                fs["devinfo"] = sysfs_devinfo
                fs["devinfo_source"] = "sysfs"

        # Add basic /sys/block info for any referenced devices.
        devs = set()
        show_data = fs["commands"].get("filesystem_show", {}).get("data")
        if isinstance(show_data, dict):
            for d in show_data.get("devices", []) or []:
                p = d.get("path")
                if p:
                    devs.add(str(p))

        src_data = fs["commands"].get("findmnt_source", {}).get("data")
        if isinstance(src_data, dict):
            src = src_data.get("source_device") or src_data.get("source")
            if isinstance(src, str) and src.strip():
                devs.add(src.strip().split("[", 1)[0])

        scrub_dev_data = fs["commands"].get("scrub_status_devices", {}).get("data")
        if isinstance(scrub_dev_data, dict):
            for p in (scrub_dev_data.get("devices") or {}).keys():
                if p:
                    devs.add(str(p))

        dev_usage_data = fs["commands"].get("device_usage", {}).get("data")
        if isinstance(dev_usage_data, dict):
            for d in dev_usage_data.get("devices", []) or []:
                p = d.get("path")
                if p:
                    devs.add(str(p))

        for p in sorted(devs):
            fs["sys_block"][p] = _sysfs_block_info(p)
        return fs, ok, first_err

    # Collect mountpoints (internal), then emit only normalized table output.
    raw_filesystems = {}
    total_ok = 0
    first_err = None
    for t in targets:
        fs, ok, ferr = collect_for_mount(t["mountpoint"])
        raw_filesystems[t["id"]] = fs
        total_ok += ok
        if first_err is None and ferr:
            first_err = ferr

    data = {"btrfs_version": btrfs_version}
    data.update(_build_tables_from_filesystems(btrfs_version, raw_filesystems))

    # Write intermediate JSON only if -i is explicitly provided
    intermediate_path = ns.intermediate_json
    if intermediate_path:
        try:
            out_dir = os.path.dirname(intermediate_path)
            if out_dir:
                os.makedirs(out_dir, exist_ok=True)
            with open(intermediate_path, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2)
            LOGGER.verbose("wrote intermediate JSON to %s", intermediate_path)
        except OSError as e:
            LOGGER.verbose("failed to write intermediate JSON: %s", e)

    if total_ok == 0:
        LOGGER.notice("all commands failed: %s", first_err)
        if not emit_data(data, 1, first_err or "all btrfs commands failed", ns.output, compress):
            return 1
        return 1

    if not emit_data(data, 0, "", ns.output, compress):
        return 1
    LOGGER.notice("finished: %d mount(s), output=%s", len(raw_filesystems), ns.output)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
